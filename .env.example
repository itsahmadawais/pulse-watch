# Runtime
NODE_ENV=development
APP_NAME=pulse-watch
# Defaults to package.json version when started via npm scripts
# APP_VERSION=0.1.0

# HTTP server
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=*

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Graceful shutdown deadline before forcing exit
SHUTDOWN_TIMEOUT_MS=10000

# Optional prefix for default Prometheus metric names (e.g. pulse_watch_). No dots/dashes.
METRICS_PREFIX=
